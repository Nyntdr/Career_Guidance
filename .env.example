APP_NAME="Ujjwol Bato"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=career_guidance
DB_USERNAME=laravel
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# --------------------------------------------------------------------------
# LLM rationale provider (optional). Placeholder until a real provider is
# configured: while RECOMMENDATION_LLM_KEY is empty, deterministic template
# rationales are used and no requests are made. Endpoint must be an
# OpenAI-compatible chat completions endpoint.
# --------------------------------------------------------------------------
RECOMMENDATION_LLM_ENDPOINT=
RECOMMENDATION_LLM_KEY=
RECOMMENDATION_LLM_MODEL=gemini-3.6-flash
RECOMMENDATION_LLM_PROVIDER=gemini
# Groq provider (optional). Set RECOMMENDATION_LLM_PROVIDER=groq to use it,
# or toggle it in Admin -> Settings -> ML. Default model is openai/gpt-oss-120b
# (non-reasoning, clean prose). The qwen/qwen3.6-27b model is NOT recommended:
# its forced thinking mode fills the free-tier 1000 OTPM cap before the answer
# is produced. List models with GET https://api.groq.com/openai/v1/models.
RECOMMENDATION_LLM_GROQ_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
RECOMMENDATION_LLM_GROQ_KEY=
RECOMMENDATION_LLM_GROQ_MODEL=openai/gpt-oss-120b
# RECOMMENDATION_LLM_TIMEOUT=60
# RECOMMENDATION_LLM_MAX_TOKENS=1024
